<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- Download managed bindings without pulling runtimes for every OS/architecture. -->
    <PackageDownload Include="org.k2fsa.sherpa.onnx" Version="[1.12.14]" />
    <Reference Include="sherpa-onnx"><HintPath>$(NuGetPackageRoot)/org.k2fsa.sherpa.onnx/1.12.14/lib/net8.0/sherpa-onnx.dll</HintPath><Private>true</Private></Reference>
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.12.14" />
  </ItemGroup>
</Project>
